# FloodLens Backend Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Supabase Credentials (Optional for local dev - backend falls back to in-memory store if absent)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# OSRM Routing Engine URL
OSRM_BASE_URL=https://router.project-osrm.org

# Sentinel-1 SAR & Remote Sensing (Optional: backend includes calibrated offline benchmark engine)
COPERNICUS_CLIENT_ID=your-copernicus-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-client-secret
GEE_SERVICE_ACCOUNT=your-gee-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=path/to/gee_private_key.json
